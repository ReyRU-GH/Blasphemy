	PainAmulet: {
		// Tooltip: ""
		// DisplayName: Pain Amulet
	}

	GlassShard: {
		Tooltip: Чередует уколы и взмахи. Агония: брошенный осколок оставляет опасное стекло.
		DisplayName: Осколок стекла
	}

	WoodenStake: {
		DisplayName: Деревянный колышек
		Tooltip: Подбрасывает самонаводящиеся сгустки крови. Агония: сгустки выпускают лучи крови.
	}

	GoldenBlade: {
		DisplayName: Золотое лезвие
		Tooltip: Выпускает струю крови. Агония: продолжительный поток с убывающим напором.
	}

	PlatinumBlade: {
		DisplayName: Платиновое лезвие
		Tooltip: Выпускает струю крови. Агония: продолжительный поток с убывающим напором.
	}

	GraveNeedle: {
		DisplayName: Могильная игла
		Tooltip: Создаёт кровавое облако. Агония: большое облако окружает игрока.
	}

	RitualDagger: {
		DisplayName: Ритуальный кинжал
		Tooltip: Бьёт всех видимых врагов. Агония: тратит здоровье до 1 и снимает дебаффы.
	}

	VoidMirror: {
		DisplayName: Зеркало пустоты
		Tooltip: Выпускает щупальца пустоты. Агония: быстрые длинные щупальца летят вперёд.
	}

	VoodooDoll: {
		DisplayName: Кукла вуду
		Tooltip: Стреляет самонаводящимися черепами сквозь стены. При низком здоровье выпускает больше.
	}

	AncientBoneShards: {
		DisplayName: Осколки древних костей
		Tooltip: Непрерывная атака стоит всё больше здоровья и выпускает больше костей. Агония: кости прилипают и наносят периодический урон.
	}

	FossilRitual: {
		// DisplayName: Fossil Ritual
		// Tooltip: ""
	}

	SpacePylon: {
		DisplayName: Небесный пилон
		Tooltip: Работает на уровне космоса при двух NPC поблизости.
	}

	CorruptPylon: {
		DisplayName: Искажённый пилон
		Tooltip: Работает в Искажении без NPC поблизости.
	}

	CrimsonPylon: {
		DisplayName: Кримзоновый пилон
		Tooltip: Работает в Кримзоне без NPC поблизости.
	}
}

